# Copy locally; supply values via your shell or a service secret store.
# Never put router credentials into Flutter, launch.json or dart-define.
AIRLINK_CONFIG=/absolute/path/to/backend/devices.json
AIRLINK_API_TOKEN=
AIRLINK_TOWER_PASSWORD=
# Optional, distinct random token; required only when PoE control ports are allowed.
AIRLINK_CONTROL_TOKEN=
AIRLINK_TOWER_CONTROL_PASSWORD=
# Local development only; bind uvicorn to 127.0.0.1.
AIRLINK_ALLOW_LOOPBACK_HTTP=1
# Only needed for Flutter web; list exact trusted origins, no wildcard.
AIRLINK_CORS_ORIGINS=http://localhost:8080
